{
  "nginx": {
    "headers": {"Server": "nginx"},
    "body_patterns": ["nginx"]
  },
  "apache": {
    "headers": {"Server": "apache"},
    "body_patterns": ["Apache"]
  },
  "cloudflare": {
    "headers": {"CF-RAY": null, "CF-Cache-Status": null},
    "body_patterns": []
  },
  "nextjs": {
    "headers": {},
    "body_patterns": ["_next/static", "__NEXT_DATA__"]
  },
  "react": {
    "headers": {},
    "body_patterns": ["react", "data-reactroot"]
  },
  "django": {
    "headers": {"Set-Cookie": "csrftoken|sessionid|django"},
    "body_patterns": ["csrfmiddlewaretoken"]
  },
  "spring": {
    "headers": {},
    "body_patterns": ["Whitelabel Error Page"]
  }
}
